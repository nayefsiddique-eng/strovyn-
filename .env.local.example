# ============================================================
# STROVYN PAINTING CO. — PUBLIC WEBSITE CONFIGURATION
# Copy this file to .env.local and populate with your production keys.
# NEVER commit .env.local to version control.
# ============================================================

# --- Canonical Site URL ---
NEXT_PUBLIC_SITE_URL=https://strovyn.com

# --- Confirmed WhatsApp & Phone Contact Variables ---
NEXT_PUBLIC_WHATSAPP_NUMBER=61406646061
NEXT_PUBLIC_PHONE_NUMBER=0406646061

# --- Optional Email Notifications (Resend) ---
# When supplied, incoming quotes and feedback trigger transactional notification emails.
# Get free key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=contact@strovyn.com

# --- Optional AI Assistant (Google Gemini API) ---
# When supplied, the Construction Assistant answers live with Gemini 2.0.
# When absent, the Assistant smoothly serves the verified architectural FAQ fallback.
# Get free key at: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# --- Optional Cloud Database & Storage (Supabase PostgreSQL & Storage) ---
# When supplied, submissions and uploads route to your Supabase PostgreSQL and private buckets.
# When absent, the application persists to local atomic files in data/ and private_storage/.
# Setup free tier at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
