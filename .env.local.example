# ============================================================
# STROVYN PAINTING CO. — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with real production keys.
# NEVER commit .env.local or actual secrets to version control.
# ============================================================

# ------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to Browser via NEXT_PUBLIC_)
# ------------------------------------------------------------
# Canonical production URL (optional locally; recommended in production)
NEXT_PUBLIC_SITE_URL=https://strovyn.com

# Confirmed WhatsApp & Phone Contact Variables
NEXT_PUBLIC_WHATSAPP_NUMBER=61406646061
NEXT_PUBLIC_PHONE_NUMBER=0406646061

# MANDATORY IN PRODUCTION — Cloud Database & Anon RLS Client (Supabase)
# When absent in production (NODE_ENV=production), /api/quotes and /api/upload
# fail closed with HTTP 503 rather than falling back to ephemeral local files.
# In local development only (npm run dev), submissions write to data/ & private_storage/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------
# RECOMMENDED / SERVER-ONLY — Reserved for privileged Supabase storage/admin ops
# Keep strictly on the server (never expose to client components).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MANDATORY FOR EMAIL NOTIFICATIONS — Transactional Mail (Resend)
# RESEND_FROM_EMAIL must use a domain verified inside your Resend dashboard.
# If omitted or invalid, quotes still persist in Supabase (201) with notified=false.
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=contact@strovyn.com
RESEND_FROM_EMAIL=Strovyn Notifications <notifications@strovyn.com>

# OPTIONAL — AI Assistant (Google Gemini API)
# When absent, STRO cleanly serves the verified architectural FAQ fallback.
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# MANDATORY IF USING /admin/photos PORTAL — Admin Authentication
STROVYN_ADMIN_KEY=replace_with_strong_admin_passphrase
ADMIN_SESSION_SECRET=replace_with_random_64_char_hex_secret
